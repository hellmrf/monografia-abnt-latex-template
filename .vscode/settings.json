{
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.folders.associations": {
        "references": "resolver",
        "bib": "lib",
        "chapters": "content"
    },
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.includeStrings": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "?latexmkrc": "perl",
        "*.tikz": "latex",
        "*.pdf_tex": "latex",
    },
    // LaTeX Outline/Structure
    "latex-workshop.view.outline.floats.enabled": false,
    "latex-workshop.view.outline.sync.viewer": false,
    "latex-workshop.view.outline.commands": [
        // "label" // mostra as definições de \label{}
    ],
    "latex-workshop.view.outline.sections": [
        "part",
        "chapter",
        "section",
        "subsection", // mostra \subsection
        // "subsubsection", // mostra \subsubsection
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.intellisense.citation.backend": "biblatex",
    "latex-workshop.bibtex-format.tab": "2 spaces",
    "latex-workshop.bibtex-format.trailingComma": true,
    "latex-workshop.bibtex-fields.sort.enabled": true,
    /// -----------
    /// COMPILAÇÃO
    /// -----------
    "latex-workshop.latex.search.rootFiles.include": [
        "main.tex"
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Build",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "Fresh Build",
            "tools": [
                "latexmkgg"
            ]
        },
        {
            "name": "Build (Stop Mode)",
            "tools": [
                "latexmk-stopmode"
            ]
        },
        {
            "name": "Soft Clean up",
            "tools": [
                "cleanup_soft"
            ]
        },
        {
            "name": "Hard Clean up",
            "tools": [
                "cleanup_hard"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-f",
                "-interaction=nonstopmode",
                "-file-line-error"
            ],
            "env": {
                "WORKSPACE_FOLDER": "%WORKSPACE_FOLDER%"
            }
        },
        {
            "name": "latexmkgg",
            "command": "latexmk",
            "args": [
                "-gg",
                "-interaction=nonstopmode",
                "-file-line-error"
            ],
            "env": {
                "WORKSPACE_FOLDER": "%WORKSPACE_FOLDER%"
            }
        },
        {
            "name": "latexmk-stopmode",
            "command": "latexmk",
            "args": [
                "-f-",
                "-file-line-error"
            ],
            "env": {
                "WORKSPACE_FOLDER": "%WORKSPACE_FOLDER%"
            }
        },
        {
            "name": "cleanup_soft",
            "command": "latexmk",
            "args": [
                "-c"
            ],
            "env": {}
        },
        {
            "name": "cleanup_hard",
            "command": "latexmk",
            "args": [
                "-C"
            ],
            "env": {}
        }
    ],
    "explorer.fileNesting.patterns": {
        ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .lfsconfig, .mailmap, .git-blame*",
        "*.tex": "$(capture).acn, $(capture).acr, $(capture).alg, $(capture).aux, $(capture).bbl, $(capture).bbl-SAVE-ERROR, $(capture).bcf, $(capture).bib, $(capture).blg, $(capture).fdb_latexmk, $(capture).fls, $(capture).glg, $(capture).glo, $(capture).gls, $(capture).idx, $(capture).ilg, $(capture).ind, $(capture).ist, $(capture).lof, $(capture).log, $(capture).lot, $(capture).nav, $(capture).out, $(capture).run.xml, $(capture).snm, $(capture).synctex.gz*, $(capture).toc, $(capture).xdv, indent.log",
    },
}
